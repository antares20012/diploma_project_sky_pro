import os
import time
from datetime import datetime
from random import randint
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.support import expected_conditions as EC

class GitHubAutomation: # или имя вашего текущего класса
    # Выносим локаторы коммита на уровень класса, чтобы не дублировать в коде
    # Используем разные варианты XPATH, чтобы клик сработал и при создании, и при редактировании
    COMMIT_CHANGES_OPEN_BTN = (By.XPATH, "//button[contains(., 'Commit changes...')] | //span[contains(text(),'Commit changes...')] | //button[contains(., 'Commit changes')]")
    COMMIT_MESSAGE_INPUT = (By.XPATH, "//input[@id='commit-message-input'] | //input[@placeholder='Commit message']")
    COMMIT_FINAL_BTN = (By.XPATH, "//button[contains(@class, 'types__Button')]//span[text()='Commit changes'] | //button[@type='submit' and contains(., 'Commit changes')]")

    def create_new_file(self, repo_name: str, file_name: str, timestamp: str = None) -> str:
        if not timestamp:
            timestamp = os.environ.get("MY_FILE_TIMESTAMP") or datetime.now().strftime("%Y%m%d_%H%M%S")

        name_parts = file_name.split('.')
        if len(name_parts) > 1:
            final_file_name = f"{name_parts[0]}_{timestamp}.{name_parts[1]}"
        else:
            final_file_name = f"{file_name}_{timestamp}"

        login = self.get_logged_in_username()
        repo_url = f"https://github.com/{login}/{repo_name}"
        self.driver.get(repo_url)

        create_new_file_link = self.wait.until(
            EC.element_to_be_clickable((By.LINK_TEXT, "creating a new file"))
        )
        create_new_file_link.click()
        time.sleep(3)

        file_name_input = self.wait.until(
            EC.visibility_of_element_located(
                (By.XPATH, "//input[@aria-label='File name' or @name='filename' or @id='file-name-editor']"))
        )
        file_name_input.send_keys(Keys.CONTROL + "a")
        file_name_input.send_keys(Keys.BACKSPACE)

        time.sleep(randint(1, 3))
        file_name_input.send_keys(final_file_name)

        # Передаем управление общему методу коммита
        self.commit_changes(final_file_name)
        print(f"Создан файл: {final_file_name}")
        return final_file_name

    def code_editor(self, repo_name: str, file_name: str, timestamp: str = None) -> str:
        login = self.get_logged_in_username()
        repo_name = "asdfh"
        file_name = "new"
        self.driver.get(self.url + f"/{login}/{repo_name}")

        file_link = self.wait.until(EC.element_to_be_clickable((By.XPATH, f"//td[@class='react-directory-row-name-cell-large-screen']//a[@title='{file_name}'][normalize-space()='{file_name}']")))
        file_link.click()
        time.sleep(3)

        edit_btn = self.wait.until(EC.element_to_be_clickable((By.CSS_SELECTOR, "[data-testid='edit-button'] svg")))
        edit_btn.click()

        input_textbox = self.wait.until(EC.presence_of_element_located((By.XPATH, "//div[contains(@role,'textbox')]")))
        new_text = """
            def greeting():
                print("Hello, World!")
            greeting()
        """
        input_textbox.send_keys(new_text)

        # Передаем управление общему методу коммита
        self.commit_changes(file_name)
        return file_name

    def commit_changes(self, file_name_for_message: str) -> None:
        """Вынесенное действие: Открытие формы коммита, ввод сообщения и сохранение"""
        current_time = datetime.now().strftime("%Y%m%d_%H%M%S")

        # СТРОКА С РЕКУРСИЕЙ УДАЛЕНА. Теперь код не зациклится.

        # 1. Клик на кнопку открытия формы коммита "Commit changes..."
        commit_changes_btn = self.wait.until(
            EC.element_to_be_clickable(self.COMMIT_CHANGES_OPEN_BTN)
        )
        commit_changes_btn.click()

        # 2. Ожидание поля ввода сообщения коммита и отправка текста
        commit_message_input = self.wait.until(
            EC.presence_of_element_located(self.COMMIT_MESSAGE_INPUT)
        )
        commit_message_input.clear() # На всякий случай очищаем поле
        commit_message_input.send_keys(f"{file_name_for_message}_{current_time}")

        # 3. Клик на главную ФИНАЛЬНУЮ кнопку подтверждения в диалоговом окне
        final_commit_btn = self.wait.until(
            EC.element_to_be_clickable(self.COMMIT_FINAL_BTN)
        )
        final_commit_btn.click()

        # Небольшая пауза для завершения отправки формы на бэкенд GitHub
        time.sleep(3)
